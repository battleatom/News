{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news",
  "main": "cloudflare-safe.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": ".cloudflare-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "FEED_STATE",
        "class_name": "FeedState"
      }
    ]
  },
  "exports": {
    "FeedState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["*/10 * * * *", "13 10 * * *"]
  },
  "observability": {
    "enabled": true
  }
}
