{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/healthz",
      "/feed.json",
      "/status.json",
      "/nfl.json",
      "/boxoffice.json",
      "/markets.json"
    ]
  },
  "observability": {
    "enabled": true
  }
}
